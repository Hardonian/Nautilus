# Nautilus / NemoClaw local runtime baseline.
# Copy to .env and only set values needed for your run mode.

# Optional: OpenAI-compatible local inference endpoint (example: Ollama/vLLM/NIM proxy).
NEMOCLAW_INFERENCE_BASE_URL=http://127.0.0.1:11434/v1

# Optional model defaults.
NEMOCLAW_MODEL=local-model
NEMOCLAW_SUBAGENT_MODEL=local-model

# Security and routing flags (default safe/off).
NEMOCLAW_GOVERNED_ROUTING=0
NEMOCLAW_HETEROGENEOUS_ROUTING=0

# Optional diagnostics behavior.
NEMOCLAW_LOCAL_PROBE_TIMEOUT_MS=3000
NEMOCLAW_ENABLE_TELEMETRY_PROBES=1
