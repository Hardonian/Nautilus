# Local operator environment template (safe defaults only)
# Do not store real secrets in this file.
NEMOCLAW_PROFILE=local
NEMOCLAW_LOG_LEVEL=info
NEMOCLAW_SANDBOX_PROVIDER=openshell

# Optional local validation token for e2e; unset by default.
# BREV_API_TOKEN=
